  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.biomesunseen.fabric.BiomesUnseenFabric"],
    "client": ["com.biomesunseen.fabric.client.BiomesUnseenFabricClient"]
  },
  "mixins": ["biomesunseen.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "architectury": "*"
  },
  "suggests": {
    "geckolib": "*",
    "cloth-config": "*"
  }
}
